<%
  tenant_name = current_organization.enabled_omniauth_providers.dig(:cohesionID, :tenant_name)
%>

<div class="row">
  <p>
    <strong>
      <%= t("decidim.authorization_handlers.#{tenant_name}_identity.title") %>
    </strong>
  </p>
  <p>
    <%= t("decidim.authorization_handlers.#{tenant_name}_identity.description") %>
  </p>
</div>

<%= button_to decidim_cohesionID.send("user_#{current_organization.enabled_omniauth_providers.dig(:cohesionID, :tenant_name)}_omniauth_authorize_path"),
              class: "button button--social button--#{normalize_provider_name(:cohesionID)}", form_class: "" do %>
  <%= t("devise.shared.links.sign_in_with_provider_cohesionID") %>
<% end %>